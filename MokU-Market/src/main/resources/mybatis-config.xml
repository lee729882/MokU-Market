<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE configuration
        PUBLIC "-//mybatis.org//DTD Config 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-config.dtd">

<configuration>

    <settings>
        <setting name="mapUnderscoreToCamelCase" value="true"/>
        <setting name="jdbcTypeForNull" value="NULL"/>
    </settings>

    <mappers>

        <!-- review 폴더 -->
        <mapper resource="mappers/review/BoardMapper.xml"/>
        <mapper resource="mappers/review/BoardLikeMapper.xml"/>
        <mapper resource="mappers/review/CommentMapper.xml"/>
        <mapper resource="mappers/review/MemberMapper.xml"/>
        <mapper resource="mappers/review/ProductMapper.xml"/>

        <!-- chat 폴더 -->
        <mapper resource="mappers/chat/chat-mapper.xml"/>

    </mappers>

</configuration>
