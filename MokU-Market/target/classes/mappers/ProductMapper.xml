<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.MokU.dao.ProductDAO">

    <!-- ✅ resultMap 정의 -->
    <resultMap id="ProductMap" type="com.MokU.vo.ProductVO">
        <id property="productId" column="PRODUCT_ID"/>
        <result property="sellerId" column="SELLER_ID"/>
        <result property="title" column="TITLE"/>
        <result property="price" column="PRICE"/>
        <result property="category" column="CATEGORY"/>
        <result property="description" column="DESCRIPTION"/>
        <result property="imagePath" column="IMAGE_PATH"/>
        <result property="placeName" column="PLACE_NAME"/>
        <result property="latitude" column="LATITUDE"/>
        <result property="longitude" column="LONGITUDE"/>
        <result property="viewCount" column="VIEW_COUNT"/>
        <result property="likeCount" column="LIKE_COUNT"/>
        <result property="status" column="STATUS"/>
        <result property="createdAt" column="CREATED_AT"/>
        <result property="updatedAt" column="UPDATED_AT"/>
    </resultMap>

    <!-- ✅ 상품 등록 -->
    <insert id="insertProduct" parameterType="com.MokU.vo.ProductVO">
        INSERT INTO PRODUCT (
            TITLE, CATEGORY, PRICE, DESCRIPTION,
            SELLER_ID, LATITUDE, LONGITUDE, IMAGE_PATH, PLACE_NAME
        ) VALUES (
            #{title},
            #{category},
            #{price},
            #{description, jdbcType=CLOB},
            #{sellerId, jdbcType=NUMERIC},
            #{latitude, jdbcType=NUMERIC},
            #{longitude, jdbcType=NUMERIC},
            #{imagePath, jdbcType=VARCHAR},
            #{placeName, jdbcType=VARCHAR}
        )
    </insert>

    <!-- ✅ 카테고리별 목록 -->
    <select id="getProductsByCategory" parameterType="string" resultMap="ProductMap">
        SELECT PRODUCT_ID, TITLE, CATEGORY, PRICE, IMAGE_PATH, VIEW_COUNT, LIKE_COUNT, STATUS, CREATED_AT
        FROM PRODUCT
        WHERE CATEGORY = #{category}
        ORDER BY CREATED_AT DESC
    </select>

    <!-- ✅ 상품 상세 조회 -->
    <select id="getProductById" parameterType="int" resultMap="ProductMap">
        SELECT *
        FROM PRODUCT
        WHERE PRODUCT_ID = #{productId}
    </select>

    <!-- ✅ 조회수 증가 -->
    <update id="increaseViewCount" parameterType="int">
        UPDATE PRODUCT
        SET VIEW_COUNT = VIEW_COUNT + 1,
            UPDATED_AT = SYSDATE
        WHERE PRODUCT_ID = #{productId}
    </update>

    <!-- ✅ 좋아요(찜) 증가 -->
    <update id="increaseLikeCount" parameterType="int">
        UPDATE PRODUCT
        SET LIKE_COUNT = LIKE_COUNT + 1,
            UPDATED_AT = SYSDATE
        WHERE PRODUCT_ID = #{productId}
    </update>

</mapper>
